# ========================================
# OSS 图片存储配置（手动上传模式 - 安全无密钥）
# ========================================

# 是否启用 OSS（true=使用OSS，false=使用本地打包）
NEXT_PUBLIC_USE_OSS=false

# OSS 基础 URL（在 Bucket 概览页面查看）
# 示例：https://your-bucket-name.oss-cn-beijing.aliyuncs.com
NEXT_PUBLIC_OSS_BASE_URL=

# 其他配置
NEXT_PUBLIC_SITE_URL=https://ellay.top
