# 管理员密码
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# TinyPNG API Key（用于服务端压缩上传图片，保持尺寸不变）
TINYPNG_API_KEY=your_tinypng_api_key

# 详情图压缩后超过该阈值（字节）时转远端存储，默认 2MB
MEDIA_INLINE_MAX_BYTES=2097152

# Cloudinary（可选：用于大图/视频远端存储）
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=portfolio

# 迁移历史内容时可执行：
# npm run migrate:storage

# 注意：
# 1. 将此文件复制为 .env.local 并修改密码
# 2. 不要将 .env.local 提交到 Git
# 3. 建议使用强密码
